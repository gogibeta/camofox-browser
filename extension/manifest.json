{
  "manifest_version": 3,
  "name": "Turnstile Auto Solver (InstaBox)",
  "version": "1.1.0",
  "description": "Auto-solves Cloudflare Turnstile widgets on opened pages using our camofox-browser solver on InstaBox. No Apify.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "https://api.instabox.sh/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turnstile Auto Solver"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
